#No KernelSU for clean test
#CONFIG_KPROBES=y
#CONFIG_KSU=y

#Loadable Kernel Module support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=n
CONFIG_MODULE_SIG=n
CONFIG_MODULE_COMPRESS=n
CONFIG_TRIM_UNUSED_KSYMS=n

#customizations
CONFIG_LOCALVERSION="-clean-test"
CONFIG_DEFAULT_HOSTNAME="a04e"

#No SusFS for clean test
#CONFIG_KSU_SUSFS=y
